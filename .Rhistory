'W38L', 'Y69D')) %>%
mutate(Sample = ifelse(Sample == 'CDS', 'Syn4-9', Sample))
dup_validations <- candidate_validations_qpcr_wtwt_fig5B %>%
filter(Type != 'SING') %>%
mutate(Sample = case_when(
Type == 'BETTER_CDS' ~ 'M1*/WT',
